{
  "name": "Maschinerie der Stadt Zürich",
  // Node-Major wie die CI (.github/workflows/ci.yml → node-version) und das
  // Dockerfile: Hier entstehen Lockfile-Änderungen, und mit Node wechselt npm.
  // Für Node 26 gibt es das Image (noch) nicht mit Image-Version vorne
  // («4-26-…»), nur als «26-bookworm». Das frühere «1-24-bookworm» liefert die
  // Registry nicht (404, Stand 2026-11) — damit liess sich der Container nicht
  // bauen.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:26-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "eslint.workingDirectories": [
          { "pattern": "stadt-zuerich-next" }
        ],
        "terminal.integrated.cwd": "${containerWorkspaceFolder}/stadt-zuerich-next"
      }
    }
  },

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Maschinerie App",
      "onAutoForward": "openBrowser"
    }
  },

  "postCreateCommand": "cd stadt-zuerich-next && npm ci",

  "postAttachCommand": {
    "welcome": "echo '' && echo '👋 Codespace bereit. Zum Starten:' && echo '   cd stadt-zuerich-next && npm run dev' && echo ''"
  },

  "remoteUser": "node",
  "waitFor": "postCreateCommand"
}
